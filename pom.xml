<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.bodden.tamiflex</groupId>
    <artifactId>tamiflex-parent</artifactId>
    <version>2.0.4-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>Normalizer</module>
        <module>Booster</module>
        <module>PlayInAgent</module>
        <module>PlayOutAgent</module>
        <module>MonitorAgent</module>
        <module>ReportingAgent</module>
        <module>TamiFlexDatabase</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
        <asm.version>9.11</asm.version>
        <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
        <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
        <build.helper.plugin.version>3.6.2</build.helper.plugin.version>
        <fmt.plugin.version>2.29</fmt.plugin.version>
        <license.plugin.version>2.7.1</license.plugin.version>
        <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
        <!-- existing sources carry hand-written EPL headers, so missing plugin headers only warn -->
        <license-check.failOnMissingHeader>false</license-check.failOnMissingHeader>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build.helper.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${javadoc.plugin.version}</version>
                    <configuration>
                        <doclint>none</doclint>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- formats sources on package; check with: mvn com.spotify.fmt:fmt-maven-plugin:check -->
            <plugin>
                <groupId>com.spotify.fmt</groupId>
                <artifactId>fmt-maven-plugin</artifactId>
                <version>${fmt.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>format</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license.plugin.version}</version>
                <configuration>
                    <failOnMissingHeader>${license-check.failOnMissingHeader}</failOnMissingHeader>
                    <failOnNotUptodateHeader>${license-check.failOnMissingHeader}</failOnNotUptodateHeader>
                    <inceptionYear>2010</inceptionYear>
                    <addJavaLicenseAfterPackage>true</addJavaLicenseAfterPackage>
                    <licenseName>epl_v1</licenseName>
                    <organizationName>Eric Bodden and others</organizationName>
                    <roots>
                        <root>src</root>
                        <root>rtlib</root>
                    </roots>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
